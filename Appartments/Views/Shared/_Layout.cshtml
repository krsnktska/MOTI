<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Appartments</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .auth-card { max-width: 450px; margin-top: 100px; border: none; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .btn-primary { background: #4e73df; border: none; }
        /* Стилі для вкладок (Tabs) */
        .nav-tabs .nav-link { color: #495057; border: none; }
        .nav-tabs .nav-link.active { font-weight: bold; color: #4e73df; border-bottom: 3px solid #4e73df; background: none; }
        /* Можна додати стилі для таблиць, щоб вони теж були гарними */
        .table { background: white; border-radius: 10px; overflow: hidden; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand text-primary fw-bold" href="/Lpr/Create">Appartments</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="/Lpr/Create">ЛПР</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Alternatives/Index">Альтернативи</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Criteria/Index">Критерії</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Vectors/Evaluate">Оцінювання</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Result/Index">Результати</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-primary" href="/Result/Compare">⚡ Прийняття рішення</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="text-success fw-bold me-3">Привіт, @User.Identity.Name!</span>
                                <button onclick="logout()" class="btn btn-outline-danger btn-sm">Вийти</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody() 
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function logout() {
            if (confirm("Бажаєте вийти з системи?")) {
                await fetch('/api/Lpr/logout', { method: 'POST' });
                window.location.href = '/Lpr/Create';
            }
        }

        function handleUnauthorized(resp) {
            if (resp.status === 401) {
                alert("Тільки зареєстровані користувачі можуть виконувати цю дію. Будь ласка, увійдіть у систему.");
                window.location.href = '/Lpr/Create';
                return true;
            }
            return false;
        }
    </script>
</body>
</html>